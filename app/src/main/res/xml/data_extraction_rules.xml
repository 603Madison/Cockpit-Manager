<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred between devices. Saved passwords are
  encrypted with a hardware-backed Keystore key that never leaves this device,
  so copies elsewhere would be unreadable anyway; the server list is cheap to
  recreate and is kept off cloud backups for privacy.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
